{
  "git": {
    "requireCleanWorkingDir": true,
    "requireUpstream": false,
    "requireCommits": false,
    "tag": true,
    "tagName": "v${version}",
    "tagAnnotation": "Release ${version}",
    "push": true,
    "pushArgs": "--follow-tags"
  },
  "github": {
    "release": true,
    "releaseName": "Release ${version}",
    "tokenRef": "GITHUB_TOKEN"
  },
  "npm": {
    "publish": false
  },
  "plugins": {
    "@release-it/conventional-changelog": {
      "infile": "CHANGELOG.md",
      "preset": "angular"
    }
  }
}
