{
  "productName": "Akira Debugger",
  "version": "0.4.0",
  "identifier": "com.akira.debugger",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "title": "Akira Debugger",
        "width": 480,
        "height": 800,
        "minWidth": 400,
        "minHeight": 300,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "fs": {
      "scope": [
        "$DOWNLOAD/*",
        "$HOME/*"
      ]
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://debugger-app.sfo3.cdn.digitaloceanspaces.com/releases/latest.json"
      ],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJBNzBCRjkyMUU3OTMyOTMKUldTVE1ua2Vrcjl3dXZudGc2ajVQV2UxK1hrY1ovajRicnZJWWplc2tzYjhCMExiSUZpQ0NWOXIK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/mac/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "universalType": "macOS"
    }
  }
}
